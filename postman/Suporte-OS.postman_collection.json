    {
      "name": "08 - Pessoas, clientes, colaboradores e vendas",
      "description": "Exercita a composição de papéis, CPF, a relação Venda-Item-Produto e a baixa transacional de estoque.",
      "item": [
        {
          "name": "Cadastrar pessoa do cliente",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "function cpf(base) { function dv(s, peso) { let soma = 0; for (const c of s) soma += Number(c) * peso--; const r = soma % 11; return r < 2 ? 0 : 11 - r; } const d1 = dv(base, 10); return base + d1 + dv(base + d1, 11); }",
              "let base = String(Date.now()).slice(-9); if ([...base].every(c => c === base[0])) base = '123456789';",
              "pm.collectionVariables.set('cpfCliente', cpf(base));"
            ]}},
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Pessoa cliente criada', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('pessoaClienteId', pm.response.json().id);"
            ]}}
          ],
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}],
