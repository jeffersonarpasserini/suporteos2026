          "name": "Produto inexistente retorna 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/produtos/9223372036854775807"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 404 e ApiError', function () {",
