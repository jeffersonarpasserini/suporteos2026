    {
      "name": "02 - Preparação dos cadastros",
      "description": "Cria os recursos utilizados pelas demais requisições e captura seus identificadores.",
      "item": [
        {
          "name": "Cadastrar grupo de produtos",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('grupoNome', 'Grupo Postman ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Location informado', function () {",
                  "    pm.response.to.have.header('Location');",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('grupoId', body.id);",
                  "pm.test('Grupo criado e ativo', function () {",
                  "    pm.expect(body.nome).to.eql(pm.collectionVariables.get('grupoNome'));",
                  "    pm.expect(body.status).to.eql('ATIVO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{grupoNome}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/grupos-produtos",
            "description": "Cria um grupo ativo com nome único."
          }
        },
        {
          "name": "Cadastrar fornecedor",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function digito(base) { let peso = base.length - 7; let soma = 0; for (const c of base) { soma += Number(c) * peso--; if (peso === 1) peso = 9; } const resto = soma % 11; return resto < 2 ? 0 : 11 - resto; }",
                  "let base = String(Date.now()).slice(-12); if ([...base].every(c => c === base[0])) base = '123456780001';",
                  "pm.collectionVariables.set('fornecedorCnpj', base + digito(base) + digito(base + digito(base)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('fornecedorId', body.id);",
                  "pm.test('Fornecedor criado', function () {",
                  "    pm.expect(body.cnpj).to.eql(pm.collectionVariables.get('fornecedorCnpj'));",
                  "    pm.expect(body.status).to.eql('ATIVO');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razaoSocial\": \"Fornecedor criado pelo Postman\",\n  \"cnpj\": \"{{fornecedorCnpj}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/fornecedores",
            "description": "Cria um fornecedor com CNPJ fictício de 14 dígitos."
          }
        },
        {
          "name": "Cadastrar produto",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('produtoCodigo', 'POSTMAN-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('produtoId', body.id);",
                  "pm.test('Produto criado com relacionamentos', function () {",
                  "    pm.expect(body.codigoBarras).to.eql(pm.collectionVariables.get('produtoCodigo'));",
                  "    pm.expect(String(body.grupoId)).to.eql(String(pm.collectionVariables.get('grupoId')));",
                  "    pm.expect(String(body.fornecedorId)).to.eql(String(pm.collectionVariables.get('fornecedorId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoBarras\": \"{{produtoCodigo}}\",\n  \"descricao\": \"Produto criado pelo Postman\",\n  \"saldoEstoque\": 10.000,\n  \"valorUnitario\": 49.90,\n  \"estoqueMinimo\": 2.000,\n  \"grupoId\": {{grupoId}},\n  \"fornecedorId\": {{fornecedorId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/produtos",
            "description": "Cria um produto associado ao grupo e ao fornecedor criados anteriormente."
          }
        }
      ]
    },
