# Profile de desenvolvimento
DB_DEV_URL=jdbc:postgresql://localhost:5432/suporteos2026_dev
DB_DEV_USERNAME=suporteos_app
DB_DEV_PASSWORD=defina-uma-senha-local

# Profile de testes
DB_TEST_URL=jdbc:postgresql://localhost:5432/suporteos2026_test
DB_TEST_USERNAME=suporteos_app
DB_TEST_PASSWORD=defina-uma-senha-local

# Banco descartável usado para comparar o esquema com as classes JPA
DB_DIFF_URL=jdbc:postgresql://localhost:5432/suporteos2026_diff
DB_DIFF_USERNAME=suporteos_app
DB_DIFF_PASSWORD=defina-uma-senha-local

# Banco descartável criado pelo Hibernate a partir das classes JPA
DB_REFERENCE_URL=jdbc:postgresql://localhost:5432/suporteos2026_reference
DB_REFERENCE_USERNAME=suporteos_app
DB_REFERENCE_PASSWORD=defina-uma-senha-local

# Profile de produção (exemplo sem valores reais)
DB_URL=jdbc:postgresql://servidor:5432/suporteos2026
DB_USERNAME=usuario-da-aplicacao
DB_PASSWORD=fornecida-pelo-ambiente

# Chave JWT Base64 com no mínimo 32 bytes. Gere outro valor para cada ambiente.
JWT_SECRET=substitua-por-uma-chave-base64-de-256-bits

# Administrador inicial para banco vazio. Ative somente na primeira execução.
INITIAL_ADMIN_ENABLED=false
INITIAL_ADMIN_NAME=Administrador do Curso
INITIAL_ADMIN_EMAIL=administrador@example.com
INITIAL_ADMIN_CPF=52998224725
INITIAL_ADMIN_LOGIN=administrador
INITIAL_ADMIN_PASSWORD=substitua-por-uma-senha-forte
